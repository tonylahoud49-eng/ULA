# Required production runtime settings.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
APP_BASE_URL=https://ula.company.example

# Use a PostgreSQL runtime role that is not the owner of the ula schema/tables
# and does not have SUPERUSER or BYPASSRLS. For PostgreSQL on this same Windows
# server, DATABASE_SSL is normally false; managed databases commonly use true.
DATABASE_URL=postgres://ula_app:replace-me@localhost:5432/ula
DATABASE_SSL=false
DATABASE_RUNTIME_ROLE=ula_app
# DATABASE_MIGRATION_URL is used only by npm run db:migrate. Do not leave the
# migration-owner credential in the Windows service environment.
# DATABASE_MIGRATION_URL=postgres://ula_migrator:replace-me@localhost:5432/ula

# Build-time production switch. Production builds reject any other value.
VITE_SQL_BACKEND=true

# Optional owner (email or account id) for legacy claims that predate ownership.
# IMPORT_DEFAULT_OWNER=director@company.example

# Keep scanned PDF bundles under this size on Claude's native PDF path.
ANTHROPIC_NATIVE_PDF_MAX_BYTES=8388608
# Cost/completion guard: 6k bounded thinking tokens plus structured-output space.
ANTHROPIC_MAX_OUTPUT_TOKENS=64000
