# Server-side AI configuration. Never expose keys through a VITE_ variable.
# Set AI_PROVIDER to one of: anthropic, openai, gemini, openrouter.
# Other configured providers may become automatic fallbacks; Claude errors are returned directly.
AI_PROVIDER=anthropic

# Anthropic Claude (Messages API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Maximum response allowance. Claude is billed only for tokens actually generated.
ANTHROPIC_MAX_OUTPUT_TOKENS=64000
# Claude preflight hard limits. Requests above either limit are stopped before analysis.
ANTHROPIC_MAX_REQUEST_BYTES=41943040
ANTHROPIC_MAX_ESTIMATED_INPUT_TOKENS=180000
ANTHROPIC_CONNECTIVITY_TIMEOUT_MS=15000
ANTHROPIC_DUPLICATE_CACHE_MS=600000
# Development diagnostics include extraction lengths, categories, model, and structured results; never API keys.
AI_DEBUG_LOGGING=true

# OpenAI (Responses API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Google Gemini (via OpenAI-compatible endpoint) — free key from aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter (free models available) — key from openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODELS=openrouter/free
OPENROUTER_MAX_COMPLETION_TOKENS=16384

# Local API server and upload safeguards.
PORT=8787
AI_MAX_FILES=20
AI_MAX_FILE_BYTES=20971520
AI_MAX_TOTAL_BYTES=52428800

# Optional directory containing approved JSON style-reference manifests.
# Historical reports loaded here influence report structure/style only, never claim facts.
ULA_REPORT_REFERENCE_DIR=

# Automated Email notifications for Annual Leave / TOIL.
# Set LEAVE_EMAIL_PROVIDER to 'emailjs' (recommended / easiest) or 'microsoft_graph'.
# Server-side only. Do not prefix any of these names with VITE_.
LEAVE_EMAIL_PROVIDER=emailjs
LEAVE_ADMIN_EMAIL=
APP_BASE_URL=http://localhost:5173

# EmailJS Provider Configuration
# Connect your Outlook/Gmail/SMTP service at https://www.emailjs.com/
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Microsoft Graph Provider Configuration (Alternative)
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_SENDER_EMAIL=

# Optional durable delivery-status file. Defaults to .data/leave-email-delivery.json.
LEAVE_MAIL_STATE_FILE=

